        "url": {
          "raw": "{{base_url}}/bookings",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "bookings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipment_id\": {{equipment_id}},\n  \"start_at\": \"{{start_at}}\",\n  \"end_at\": \"{{end_at}}\",\n  \"purpose\": \"Съемка студенческого проекта\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Для работы нужен запущенный локальный API; код и описание — в README."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Заявка создана (201)\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set(\"booking_id\", pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
