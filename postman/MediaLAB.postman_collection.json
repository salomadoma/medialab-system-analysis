  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Даты в ближайшем будущем; время в UTC с указанием пояса Z.",
          "const start = new Date(Date.now() + 10 * 60 * 1000);",
          "const end = new Date(start.getTime() + 2 * 60 * 60 * 1000);",
          "pm.collectionVariables.set(\"start_at\", start.toISOString());",
          "pm.collectionVariables.set(\"end_at\", end.toISOString());"
        ]
      }
    }
